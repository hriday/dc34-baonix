+// --- local repair (not upstream) ---
+/// Packets copied out of the IRQ's scratch buffer, with their lengths.
+///
+/// # Why this exists
+///
+/// The receive path used to leave each packet in the single shared
+/// `Bao1xUsb::serial_rx` and tell the main loop only how many bytes had
+/// arrived. `claim_interrupt` gives the handler the same `Box<Bao1xUsb>` the
+/// main loop holds, so those are the same 512 bytes: a packet arriving before
+/// the main loop drained the previous notification overwrote data that had
+/// already been counted, and the older count was then satisfied from the newer
+/// bytes. The symptom is byte totals that are exactly right with contents that
+/// are wrong -- which is invisible to any test whose payload is a single
+/// repeated byte, and that is precisely why it survived so long here.
+///
+/// Copying at IRQ time is the fix: the bytes and their length travel together
+/// and nothing can overwrite a packet that has already been accounted for.
+///
+/// # Depth
+///
+/// [`SERIAL_RX_SLOTS`] = 64, i.e. 32 KiB. **Was 16, and 16 was measured too
+/// small on hardware** (2026-09-01: `serial rx ring overflowed: 2` then `4`).
+/// The arithmetic that produced 16 counted the wrong thing.
+///
+/// One 4109-byte page frame is `ceil(4109 / 512)` = **9** packets. The old
+/// number stopped there, on the grounds that the client's exchange is
+/// synchronous -- one *request* outstanding, therefore one response in flight.
+/// That is true of requests and false of packets on the wire, because the
+/// client **retries**: `usbhost::RETRY_BUDGET` is 3, so an exchange may send
+/// the same request up to **4** times, and a re-send whose predecessor was
+/// merely late (not lost) has the host answering both. The worst case this ring
+/// must survive is therefore a full retry storm:
+///
+/// ```text
+///   (RETRY_BUDGET + 1) attempts x 9 packets per reply  =  36 packets
+/// ```
+///
+/// 64 is the next power of two above 36 -- 78% headroom, the same margin the
+/// old figure claimed against the wrong denominator -- and a power of two keeps
+/// the head/tail arithmetic cheap in an interrupt handler.
+///
+/// **Assumptions, stated so they can be checked against a transcript.** (1) The
+/// host paces at 512 B/ms, so 36 packets is ~36 ms of wire time and the ring
+/// has to cover any main-loop stall shorter than that; the flush watchdog
+/// (`FLUSH_MS` = 5) is what bounds such a stall, so this is ~7x the watchdog
+/// period. (2) `ConIn` keystroke frames and mirrored log text share the stream
+/// and are single packets; a handful of them fits in the remaining 28 slots.
+/// (3) Nothing pipelines page requests. If that last one ever changes, this
+/// number is `(in-flight requests) x 9 x (RETRY_BUDGET + 1)` and wants
+/// recomputing rather than doubling.
+///
+/// The USB server's own 128-slot message queue is *not* the bound here, and the
+/// old comment saying so had it backwards: the queue filling is precisely the
+/// condition under which the ring has to hold, because a wake-up posted with
+/// `try_send_message(..).ok()` is dropped when the queue is full. The ring is
+/// the thing that makes that lossless, so sizing it *below* the queue defeats
+/// its purpose.
+///
+/// # Why the slots are on the heap
+///
+/// `main.rs` constructs this as `Box::new(Bao1xUsb::new(..))`, which builds the
+/// struct in the caller's frame and then moves it. Rust guarantees no placement
+/// construction, so an inline `[[u8; 512]; 64]` would put 32 KiB on the main
+/// thread's stack at startup on the chance the move is not elided. A boxed
+/// slice costs one indirection on a path that is already a `memcpy`, and makes
+/// the depth a number that can be raised without a stack-overflow argument.
+///
+/// # Overflow
+///
+/// Counted in [`SerialRxRing::overflows`], never silent. An interrupt handler
+/// is the wrong place to log, so it only bumps the counter; the main loop
+/// reports the change -- from the `SerialFlush` watchdog and **not** from the
+/// receive handler, see the report site in `main.rs` for why that distinction
+/// cost a hardware run. A non-zero count means the main loop is not draining
+/// fast enough and packets were dropped -- which is data loss, and the
+/// transport above will see it as a dropped frame and retry.
+pub const SERIAL_RX_SLOTS: usize = 64;
+
+pub struct SerialRxRing {
+    /// Boxed, not inline: see "Why the slots are on the heap" above.
+    slots: Box<[[u8; SERIAL_MAX_PACKET_SIZE]]>,
+    lens: Box<[usize]>,
+    /// Next slot the IRQ will write. Only the IRQ advances it.
+    head: AtomicUsize,
+    /// Next slot the main loop will read. Only the main loop advances it.
+    tail: AtomicUsize,
+    /// Packets dropped because the ring was full.
+    pub overflows: AtomicUsize,
+}
+
+impl SerialRxRing {
+    /// Allocates the ring. Called once, from `Bao1xUsb::new`, before
+    /// `claim_interrupt` -- so the IRQ can never observe a half-built ring.
+    pub fn new() -> Self {
+        Self {
+            slots: vec![[0u8; SERIAL_MAX_PACKET_SIZE]; SERIAL_RX_SLOTS].into_boxed_slice(),
+            lens: vec![0usize; SERIAL_RX_SLOTS].into_boxed_slice(),
+            head: AtomicUsize::new(0),
+            tail: AtomicUsize::new(0),
+            overflows: AtomicUsize::new(0),
+        }
+    }
+
+    /// Copies one packet in. **IRQ context only.**
+    ///
+    /// The store of `head` is `Release` and last, so the bytes and the length
+    /// are already visible to the main loop when the new head is.
+    pub fn push(&mut self, data: &[u8]) {
+        let head = self.head.load(Ordering::Relaxed);
+        let tail = self.tail.load(Ordering::Acquire);
+        let next = (head + 1) % SERIAL_RX_SLOTS;
+        if next == tail {
+            // Full. Drop the packet rather than overwrite one the main loop has
+            // not read -- overwriting is the bug this ring exists to fix.
+            self.overflows.fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+        let n = data.len().min(SERIAL_MAX_PACKET_SIZE);
+        self.slots[head][..n].copy_from_slice(&data[..n]);
+        self.lens[head] = n;
+        self.head.store(next, Ordering::Release);
+    }
+
+    /// Takes the next packet out, or `None` when empty. **Main loop only.**
+    pub fn pop(&mut self, out: &mut [u8; SERIAL_MAX_PACKET_SIZE]) -> Option<usize> {
+        let tail = self.tail.load(Ordering::Relaxed);
+        if tail == self.head.load(Ordering::Acquire) {
+            return None;
+        }
+        let n = self.lens[tail];
+        out[..n].copy_from_slice(&self.slots[tail][..n]);
+        self.tail.store((tail + 1) % SERIAL_RX_SLOTS, Ordering::Release);
+        Some(n)
+    }
+}
